# =============================================================================
# RTRWH Platform — Environment Variables Example
# Copy this file to .env and fill in the required values.
# NEVER commit .env to version control.
# =============================================================================

# --- Backend ---

# Database URL (SQLite for local development)
# For production PostgreSQL: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./rtrwh_data.db

# CORS — allowed origins (comma-separated, or * for development only)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application environment (development | staging | production)
APP_ENV=development

# Log level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# API host and port
API_HOST=127.0.0.1
API_PORT=8000

# --- Frontend ---

# Backend API URL (used by Vite)
VITE_API_BASE_URL=http://localhost:8000

# Application title
VITE_APP_NAME=HydroRefil — RTRWH Assessment Platform

# Map tile provider (osm | mapbox)
VITE_MAP_PROVIDER=osm

# Mapbox token (only required if VITE_MAP_PROVIDER=mapbox)
# VITE_MAPBOX_TOKEN=your_mapbox_public_token_here

# Feature flags
VITE_ENABLE_DEMO_MODE=true
VITE_ENABLE_OFFLINE_CALC=true
